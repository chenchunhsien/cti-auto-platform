# ===== Luminar STIX 2.1 API =====
LUMINAR_BASE_URL="https://cyberluminar.com"
LUMINAR_REALM="your-realm-uuid"
LUMINAR_CLIENT_ID="your-client-id"
LUMINAR_CLIENT_SECRET="your-client-secret"

# ===== GitHub Auto Push =====
GITHUB_USER="your-github-user"
GITHUB_REPO="cti-auto-platform"
GITHUB_PAT="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GITHUB_BRANCH="main"

# ===== Filtering Thresholds (optional) =====
MIN_CONFIDENCE="90"
MIN_THREAT_SCORE="90"

# ===== Fetch behaviour (optional) =====
# 無 high-water mark 時預設回溯時數
DEFAULT_LOOKBACK_HOURS="24"
# 單頁筆數（官方文件建議 10、上限 100；實測 10 對 24 小時視窗要爬數百頁，
# 改用上限值可大幅減少來回次數。若遇 HTTP 408 逾時請調小，官方建議 10）
PAGE_LIMIT="100"
# 分頁 scroll 保活時間（官方文件 duration 參數；10s/10m/10h/1d）
LUMINAR_SCROLL_DURATION="2m"
# 最大分頁數保護（長時間斷線後的大量回溯資料，可能需跨多次排程才能補抓完畢）
MAX_PAGES="2000"
# API 路徑與授權範圍（依官方文件 v4.0 設定，通常不需更動）
LUMINAR_TOKEN_PATH="/externalApi/v2/realm/{realm}/token"
LUMINAR_QUERY_PATH="/externalApi/v2/stix"
LUMINAR_QUERY_NEXT_PATH="/externalApi/v2/stix/next"
# 必填！Token 請求漏帶此 scope 會導致查詢一律被拒
LUMINAR_SCOPE="externalAPI/stix.readonly"
